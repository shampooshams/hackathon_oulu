# Add ONE of these for full AI answers (otherwise offline templates are used)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# Real Liiga API (stats API v1). Put the key only in .env, never in this file.
# If this base doesn't work, run `python probe_api.py`: it tries the alternatives and tells you which one answers.
LIIGA_API_BASE=https://prod.liiga-backend.liiga.fi/stats
LIIGA_API_KEY=
LIIGA_SEASON=2027
# The app uses real Liiga data. Set COMPANION_DATA=mock only to work offline with fictional demo data.
# COMPANION_DATA=mock

# Demo settings
COMPANION_AS_OF=2026-10-24
COMPANION_SIMULATIONS=10000
